// ── Platform-level tables (one copy per regional cell, not tenant-owned) ──

model User {
  id                String             @id @db.Char(36)
  email             String             @unique @db.VarChar(254)
  passwordHash      String?            @map("password_hash") @db.VarChar(255)
  emailVerifiedAt   DateTime?          @map("email_verified_at") @db.DateTime(3)
  displayName       String             @map("display_name") @db.VarChar(120)
  locale            String             @default("en") @db.VarChar(16)
  timezone          String             @default("UTC") @db.VarChar(64)
  status            UserStatus         @default(ACTIVE)
  failedLoginCount  Int                @default(0) @map("failed_login_count")
  lockedUntil       DateTime?          @map("locked_until") @db.DateTime(3)
  lastLoginAt       DateTime?          @map("last_login_at") @db.DateTime(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  platformAdmin     PlatformAdmin?
  refreshTokens     RefreshToken[]
  mfaFactors        MfaFactor[]
  recoveryCodes     RecoveryCode[]
  authTokens        AuthToken[]
  tenantMemberships TenantMembership[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model PlatformAdmin {
  id               String            @id @db.Char(36)
  userId           String            @unique @map("user_id") @db.Char(36)
  role             PlatformRole
  createdAt        DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  breakGlassGrants BreakGlassGrant[]

  @@map("platform_admins")
}

enum PlatformRole {
  OWNER
  SUPPORT
  BILLING
  SECURITY
}

model RefreshToken {
  id            String    @id @db.Char(36)
  userId        String    @map("user_id") @db.Char(36)
  tenantId      String?   @map("tenant_id") @db.Char(36)
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  familyId      String    @map("family_id") @db.Char(36)
  userAgent     String?   @map("user_agent") @db.VarChar(255)
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  expiresAt     DateTime  @map("expires_at") @db.DateTime(3)
  idleExpiresAt DateTime  @map("idle_expires_at") @db.DateTime(3)
  rotatedAt     DateTime? @map("rotated_at") @db.DateTime(3)
  revokedAt     DateTime? @map("revoked_at") @db.DateTime(3)
  revokeReason  String?   @map("revoke_reason") @db.VarChar(40)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model MfaFactor {
  id           String    @id @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
  type         MfaType
  secretEnc    Bytes     @map("secret_enc") @db.VarBinary(512)
  label        String?   @db.VarChar(80)
  confirmedAt  DateTime? @map("confirmed_at") @db.DateTime(3)
  lastUsedStep BigInt?   @map("last_used_step")
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId])
  @@map("mfa_factors")
}

enum MfaType {
  TOTP
  WEBAUTHN
}

model RecoveryCode {
  id        String    @id @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId])
  @@map("recovery_codes")
}

model AuthToken {
  id        String           @id @db.Char(36)
  userId    String           @map("user_id") @db.Char(36)
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime         @map("expires_at") @db.DateTime(3)
  usedAt    DateTime?        @map("used_at") @db.DateTime(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  INVITE
}

model Permission {
  code            String           @id @db.VarChar(80)
  module          String           @db.VarChar(40)
  description     String           @db.VarChar(255)
  isSensitive     Boolean          @default(false) @map("is_sensitive")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model Plan {
  id                         String         @id @db.Char(36)
  code                       String         @unique @db.VarChar(40)
  name                       String         @db.VarChar(120)
  isPublic                   Boolean        @default(true) @map("is_public")
  maxEmployees               Int?           @map("max_employees")
  screenshotRetentionMaxDays Int            @default(90) @map("screenshot_retention_max_days")
  features                   Json
  createdAt                  DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                  DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  planPrices                 PlanPrice[]
  tenants                    Tenant[]
  subscriptions              Subscription[]

  @@map("plans")
}

model PlanPrice {
  id              String          @id @db.Char(36)
  planId          String          @map("plan_id") @db.Char(36)
  currency        String          @db.Char(3)
  interval        BillingInterval
  unitAmount      Decimal         @map("unit_amount") @db.Decimal(19, 4)
  providerPriceId String?         @map("provider_price_id") @db.VarChar(120)
  plan            Plan            @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([planId, currency, interval])
  @@map("plan_prices")
}

enum BillingInterval {
  MONTH
  YEAR
}

model CountryProfile {
  code                 String               @id @db.Char(2)
  name                 String               @db.VarChar(100)
  defaultCurrency      String               @map("default_currency") @db.Char(3)
  defaultLocale        String               @map("default_locale") @db.VarChar(16)
  weekendDays          Json                 @map("weekend_days")
  fieldRules           Json                 @map("field_rules")
  nationalIdTypes      Json                 @map("national_id_types")
  bankFieldFormat      Json                 @map("bank_field_format")
  addressFormat        Json                 @map("address_format")
  payrollCoverage      PayrollCoverage      @default(CONFIGURABLE) @map("payroll_coverage")
  version              Int                  @default(1)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  statutoryRulePacks   StatutoryRulePack[]
  jurisdictionPolicies JurisdictionPolicy[]
  legalEntities        LegalEntity[]

  @@map("country_profiles")
}

enum PayrollCoverage {
  NATIVE
  CONFIGURABLE
  EXPORT
}

model Currency {
  code       String @id @db.Char(3)
  name       String @db.VarChar(60)
  minorUnits Int    @map("minor_units")

  @@map("currencies")
}

model FxRate {
  id        String   @id @db.Char(36)
  base      String   @db.Char(3)
  quote     String   @db.Char(3)
  rate      Decimal  @db.Decimal(19, 10)
  rateDate  DateTime @map("rate_date") @db.Date
  source    String   @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([base, quote, rateDate, source])
  @@map("fx_rates")
}

model StatutoryRulePack {
  id                      String                   @id @db.Char(36)
  code                    String                   @unique @db.VarChar(60)
  countryCode             String                   @map("country_code") @db.Char(2)
  regionCode              String                   @default("") @map("region_code") @db.VarChar(10)
  name                    String                   @db.VarChar(120)
  engineModule            String                   @map("engine_module") @db.VarChar(60)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  country                 CountryProfile           @relation(fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  statutoryRuleVersions   StatutoryRuleVersion[]
  tenantStatutorySettings TenantStatutorySetting[]

  @@map("statutory_rule_packs")
}

model StatutoryRuleVersion {
  id            String            @id @db.Char(36)
  packId        String            @map("pack_id") @db.Char(36)
  version       Int
  rules         Json
  effectiveFrom DateTime          @map("effective_from") @db.Date
  effectiveTo   DateTime?         @map("effective_to") @db.Date
  checksum      String            @db.Char(64)
  reviewedBy    String?           @map("reviewed_by") @db.VarChar(120)
  publishedAt   DateTime          @map("published_at") @db.DateTime(3)
  pack          StatutoryRulePack @relation(fields: [packId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([packId, version])
  @@index([packId, effectiveFrom])
  @@map("statutory_rule_versions")
}

model JurisdictionPolicy {
  id                 String                @id @db.Char(36)
  countryCode        String                @map("country_code") @db.Char(2)
  regionCode         String                @default("") @map("region_code") @db.VarChar(10)
  version            Int
  screenshotsAllowed JurisdictionAllowance @map("screenshots_allowed")
  activityAllowed    JurisdictionAllowance @map("activity_allowed")
  requiredSteps      Json                  @map("required_steps")
  maxRetentionDays   Int?                  @map("max_retention_days")
  minNoticeDays      Int                   @default(7) @map("min_notice_days")
  legalReviewedOn    DateTime?             @map("legal_reviewed_on") @db.Date
  effectiveFrom      DateTime              @map("effective_from") @db.Date
  createdAt          DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  country            CountryProfile        @relation(fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@unique([countryCode, regionCode, version])
  @@map("jurisdiction_policies")
}

enum JurisdictionAllowance {
  ALLOWED
  ALLOWED_WITH_STEPS
  NOT_ALLOWED
  UNKNOWN
}

model PublicHolidaySet {
  id          String @id @db.Char(36)
  countryCode String @map("country_code") @db.Char(2)
  regionCode  String @default("") @map("region_code") @db.VarChar(10)
  year        Int
  holidays    Json
  source      String @db.VarChar(60)

  @@unique([countryCode, regionCode, year])
  @@map("public_holiday_sets")
}

model FeatureFlag {
  key         String   @id @db.VarChar(80)
  description String   @db.VarChar(255)
  defaultOn   Boolean  @default(false) @map("default_on")
  rules       Json?
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("feature_flags")
}

model PaymentWebhookEvent {
  id          String          @id @db.Char(36)
  provider    PaymentProvider
  eventId     String          @map("event_id") @db.VarChar(120)
  type        String          @db.VarChar(80)
  payload     Json
  processedAt DateTime?       @map("processed_at") @db.DateTime(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([provider, eventId])
  @@map("payment_webhook_events")
}
