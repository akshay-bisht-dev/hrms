# Copy to .env for local development:  cp .env.example .env
# Never commit .env. Production values come from AWS Secrets Manager.

NODE_ENV=development
PORT=3000
CELL_REGION=local
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173
# Comma-separated extra browser origins (defaults to FRONTEND_URL)
CORS_ORIGINS=

# MySQL 8.4 (docker compose service "mysql"). Pool size is part of the URL.
# allowPublicKeyRetrieval is for local plain-TCP only: after a MySQL restart, caching_sha2_password needs it
# (or TLS) for the first login. Production connects to RDS over TLS (add ssl=true) and must not set it.
DATABASE_URL=mysql://hrms:hrms_dev_password@127.0.0.1:3306/hrms?connectionLimit=10&allowPublicKeyRetrieval=true
# Redis 7 for cache/rate limits, and for BullMQ queues (can be a separate instance in production)
REDIS_URL=redis://127.0.0.1:6379
REDIS_QUEUE_URL=

# API documentation (Swagger UI at /api/docs). Off in production unless set to true.
ENABLE_API_DOCS=true

# ── Added by later sprints (validated at startup once their module exists) ──
# Sprint 2 — auth. Fill the three secrets locally with:  npm run keys:dev -w apps/backend
APP_URL=http://localhost:5173
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEYS=
JWT_REFRESH_PEPPER=
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_IDLE_TTL_SEC=86400
REFRESH_ABSOLUTE_TTL_SEC=1209600
# Secure cookies are forced in production; plain HTTP localhost needs false.
COOKIE_SECURE=false
MFA_ISSUER=Workforce HRMS
MFA_ENFORCE_FOR_SENSITIVE=true
# off | hibp (sends only a 5-character SHA-1 prefix to api.pwnedpasswords.com)
PASSWORD_BREACH_CHECK=off
TRIAL_DAYS=14
# Per-IP limits (offices share an IP; per-account lockout is the main brute-force control)
AUTH_IP_LIMIT_PER_MIN=60
AUTH_EMAIL_IP_LIMIT_PER_HOUR=30

# Sprint 4/10 — storage. Locally SeaweedFS (docker compose service "s3") stands in for AWS S3.
AWS_REGION=ap-south-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET_DOCUMENTS=hrms-documents
S3_BUCKET_SCREENSHOTS=hrms-screenshots
S3_BUCKET_REPORTS=hrms-reports
# Local SeaweedFS keys only (infrastructure/docker/seaweedfs-s3.json). In AWS leave S3_ENDPOINT and these empty: the task IAM role is used.
S3_ACCESS_KEY_ID=local_dev_access_key
S3_SECRET_ACCESS_KEY=local_dev_secret_key

# Email (Mailpit locally: http://localhost:8025)
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@hrms.local
SMTP_URL=smtp://127.0.0.1:1025

# Work status & monitoring guardrails
SCREENSHOT_RETENTION_DAYS=30
SCREENSHOT_MIN_INTERVAL_MIN=5
HEARTBEAT_TIMEOUT_SEC_DEFAULT=180

# Desktop agent sessions
DEVICE_ACCESS_TOKEN_TTL_SEC=600
DEVICE_REFRESH_TOKEN_TTL_DAYS=30
PAIRING_CODE_TTL_SEC=600

# Worker
WORKER_SYSTEM_CONCURRENCY=2
